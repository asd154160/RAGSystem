# PostgreSQL
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragsystem

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# LLM (支持 OpenAI / DeepSeek / Claude / Qwen / OpenAI-compatible)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=
LLM_MODEL_NAME=gpt-4o
LLM_TEMPERATURE=0.1

# HuggingFace 镜像（国内加速）
# HF_ENDPOINT=https://hf-mirror.com

# 自定义模型路径（可选，默认 /app/models/）
# BGE_M3_PATH=/app/models/bge-m3
# RERANKER_PATH=/app/models/bge-reranker-v2-m3
