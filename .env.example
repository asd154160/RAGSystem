# PostgreSQL
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragsystem

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# LLM (支持 OpenAI / DeepSeek / Claude / Qwen / OpenAI-compatible)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=
LLM_MODEL_NAME=gpt-4o
LLM_TEMPERATURE=0.1

# MinIO 公开端点（用于生成浏览器可访问的 presigned URL）
# 本地开发用 localhost:9000，生产部署改为公网域名
MINIO_PUBLIC_ENDPOINT=localhost:9000

# CORS 跨域白名单 — 逗号分隔的允许访问后端的域名
# 本地开发：http://localhost:3000
# 公网部署：http://localhost:3000,https://your-domain.com
# 调试时可设为 * 允许所有源（不建议生产使用）
CORS_ORIGINS=http://localhost:3000

# 前端 API 地址（容器内走 next.config.js 代理，留空；本地开发设 http://localhost:8000）
NEXT_PUBLIC_API_URL=

# HuggingFace 镜像（国内加速）
# HF_ENDPOINT=https://hf-mirror.com

# 自定义模型路径（可选，默认 /app/models/）
# BGE_M3_PATH=/app/models/bge-m3
# RERANKER_PATH=/app/models/bge-reranker-v2-m3
